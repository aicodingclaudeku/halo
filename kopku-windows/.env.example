# KOPKU LAN Server — contoh konfigurasi WhatsApp Cloud API.
#
# JANGAN isi kredensial asli di berkas ini dan JANGAN commit ke Git.
# Salin menjadi "kopku-server.env" di FOLDER DATA KOPKU Desktop
#   Windows : %APPDATA%\KOPKU Desktop\kopku-server.env
#   macOS   : ~/Library/Application Support/KOPKU Desktop/kopku-server.env
# atau set sebagai environment variable Windows (prioritas tertinggi).
# Alternatif access token: isi lewat Panel Web › WhatsApp Reminder
# (disimpan terenkripsi DPAPI, tidak pernah ditampilkan lagi).

# ID nomor pengirim (WhatsApp Manager › API Setup › Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=
# ID akun WhatsApp Business (informasi; tidak dipakai untuk kirim)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Access token (System User token permanen disarankan)
WHATSAPP_ACCESS_TOKEN=
# Versi Graph API, format vNN.N
WHATSAPP_API_VERSION=v21.0
# Nama template yang SUDAH DISETUJUI (approved), kategori UTILITY.
# Body template wajib memiliki 6 parameter berurutan:
#   {{1}} nama anggota   {{2}} nomor pinjaman   {{3}} angsuran ke
#   {{4}} tanggal jatuh tempo   {{5}} sisa angsuran (Rp)   {{6}} keterangan waktu
# Contoh body:
#   Yth. {{1}}, angsuran ke-{{3}} pinjaman {{2}} sebesar {{5}} {{6}} ({{4}}).
#   Abaikan pesan ini bila sudah membayar. Terima kasih.
WHATSAPP_TEMPLATE_NAME=
# Kode bahasa template (id = Bahasa Indonesia)
WHATSAPP_TEMPLATE_LANG=id
