{
  "expo": {
    "name": "Kopku",
    "slug": "kopku",
    "scheme": "Kopku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F8FC",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "id.koperasi.finance",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA"
      ],
      "splash": {
        "backgroundColor": "#F5F8FC",
        "dark": {
          "backgroundColor": "#F5F8FC"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-font",
      "expo-background-task",
      "./plugins/withSplashNativePolos",
      "./plugins/withKameraPindaiQr",
      "./plugins/withLanSyncCleartext"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "48d3c539-5836-4785-aae5-ccb4610dc0eb"
      }
    }
  }
}
