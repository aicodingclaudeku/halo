{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "decimal.js": [
        "./src/test-utils/decimalShim.ts"
      ],
      "expo-sqlite": [
        "./src/test-utils/expoSqliteMock.ts"
      ],
      "expo-crypto": [
        "./src/test-utils/expoCryptoMock.ts"
      ]
    }
  },
  "include": [
    ".harness/rn-ambient.d.ts",
    "src/screens/Laporan/LaporanScreen.tsx",
    "src/screens/Laporan/PosisiKeuanganScreen.tsx",
    "src/screens/Laporan/ArusKasScreen.tsx",
    "src/screens/Laporan/CalkScreen.tsx",
    "src/screens/Laporan/LabaRugiScreen.tsx",
    "src/screens/Laporan/PerubahanEkuitasScreen.tsx",
    "src/reports/FinancialReports.ts"
  ]
}
