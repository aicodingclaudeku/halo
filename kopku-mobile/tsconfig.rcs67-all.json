    "target": "ES2021", "lib": ["ES2021"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "types": [],
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./src/*"],
