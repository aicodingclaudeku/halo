{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "baseUrl": ".",
    "outDir": ".harness/build3",
    "rootDir": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [".harness/ambient.d.ts", ".harness/rn-ambient.d.ts", ".harness/dateFnsShim.ts", ".harness/decimalHarness.ts", "src/**/*.ts"]
}
