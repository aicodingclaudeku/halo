{
  "name": "kopku-desktop",
  "productName": "KOPKU Desktop",
  "version": "1.0.13",
  "description": "KOPKU — aplikasi keuangan koperasi simpan pinjam (Windows & macOS), offline-first, sinkron dengan HP lewat Wi-Fi lokal.",
  "author": "KOPKU",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "start": "electron .",
    "dev": "node scripts/build-renderer.js && electron .",
    "test": "node test/e2e/jalankan.js",
    "dist:win": "node scripts/build-renderer.js && electron-builder --win --x64 --publish never",
    "postdist:win": "node scripts/verifikasi-fuse.js \"dist/win-unpacked/KOPKU Desktop.exe\"",
    "dist:mac": "node scripts/build-renderer.js && electron-builder --mac --x64 --arm64 --publish never",
    "dist:win-installer": "node scripts/build-renderer.js && sh scripts/build-installer-win.sh",
    "test:ui": "node test/ui/jalankan-ui.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.0.12",
    "esbuild": "^0.25.0",
    "resedit": "^2.0.3",
    "pe-library": "^1.0.1"
  },
  "build": {
    "appId": "id.koperasi.finance.desktop",
    "productName": "KOPKU Desktop",
    "copyright": "KOPKU",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "artifactName": "KOPKU-Desktop-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KOPKU Desktop",
      "deleteAppDataOnUninstall": false,
      "artifactName": "KOPKU-Desktop-${version}-Setup.${ext}",
      "include": "installer/firewall.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "language": "1057"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "KOPKU-Desktop-${version}-macOS-${arch}.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "KOPKU Desktop menerima sinkronisasi dari aplikasi KOPKU di HP melalui Wi-Fi lokal."
      }
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://koperasikufinanace.my.id/downloads/windows/"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
