{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "decimal.js": ["./src/test-utils/decimalShim.ts"],
      "expo-sqlite": ["./src/test-utils/expoSqliteMock.ts"],
      "expo-crypto": ["./src/test-utils/expoCryptoMock.ts"]
    }
  },
  "include": [
    ".harness/rn-ambient.d.ts",
    "src/theme/colors.ts",
    "src/theme/ui.ts",
    "src/screens/Transaksi/TransaksiPengeluaranScreen.tsx",
    "src/screens/Transaksi/TransaksiScreen.tsx",
    "src/screens/Transaksi/TransaksiPenerimaanScreen.tsx",
    "src/screens/Transaksi/PenyesuaianScreen.tsx",
    "src/screens/Transaksi/BayarUtangFormScreen.tsx",
    "src/screens/Transaksi/AkruiBungaUtangFormScreen.tsx",
    "src/screens/Transaksi/BebanFormScreen.tsx",
    "src/screens/Transaksi/TarikSimpananFormScreen.tsx"
  ]
}
